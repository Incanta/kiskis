# Required. Bootstrap password for the admin account. Used on first run to seed the admin
# row. To rotate later, change this and restart; the next successful login replaces the hash.
ADMIN_PASSWORD=change-me

# Optional. Default 8787.
PORT=8787

# Optional. Default ./data
DATA_DIR=./data

# Optional. Set to "true" only if serving over HTTPS (controls the Secure cookie flag).
SECURE_COOKIES=false

# Optional. Max bytes of plaintext per upload. Default 2 GiB (2147483648).
MAX_FILE_BYTES=2147483648
