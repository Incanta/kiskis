{
  "name": "kiskis",
  "version": "0.1.0",
  "description": "Keep It Secret, Keep It Safe — end-to-end encrypted file sharing.",
  "type": "module",
  "private": true,
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "tsc -p tsconfig.web.json && node scripts/copy-static.mjs",
    "build": "yarn run build:server && yarn run build:web",
    "dev": "yarn build && node --watch --env-file=.env dist/server/index.js",
    "start": "node --env-file=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "clean": "node -e \"import('node:fs/promises').then(f=>Promise.all(['dist','src/web/js'].map(p=>f.rm(p,{recursive:true,force:true}))))\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
